{
  "name": "electron-server-mon",
  "version": "1.0.0",
  "description": "Server monitoring via SSH",
  "main": "main.js",
  "author": "oalaov",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.oalaov.servermon",
    "productName": "Server Monitor",
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "ssh.js",
      "database.js",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis"]
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "node-ssh": "^13.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "better-sqlite3@11.10.0": true,
    "ssh2@1.17.0": true,
    "cpu-features@0.0.10": true
  }
}