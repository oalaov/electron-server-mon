{
  "name": "electron-server-mon",
  "version": "1.0.0",
  "description": "Server monitoring via SSH",
  "main": "main.js",
  "author": "oalaov",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.oalaov.servermon",
    "productName": "Server Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer.js",
      "index.html",
      "style.css",
      "ssh.js",
      "database.js",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "node-ssh": "^13.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}